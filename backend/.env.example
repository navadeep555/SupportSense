# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is git-ignored. NEVER put real secrets in this example file.

APP_ENV=development
# Comma-separated list of browser origins allowed to call the API (Vite dev server).
CORS_ORIGINS=http://localhost:5173

# ---- RAG (optional: these are the defaults) ----
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CHUNK_SIZE_WORDS=150
# CHUNK_OVERLAP_WORDS=30
# RETRIEVAL_TOP_K=5
# MIN_EVIDENCE_SIMILARITY=0.35

# ---- LLM (Phase 4) ----
# "mock" works with no model installed; "ollama" needs Ollama running locally.
LLM_PROVIDER=mock
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# LLM_TIMEOUT_SECONDS=120

# ---- Database (Phase 5) ----
# Default: SQLite file backend/data/supportsense.db (git-ignored, created on startup).
# Phase 9 sets this to a PostgreSQL URL. Real DB passwords go only in .env, never here.
# DATABASE_URL=sqlite:///D:/path/to/supportsense.db
